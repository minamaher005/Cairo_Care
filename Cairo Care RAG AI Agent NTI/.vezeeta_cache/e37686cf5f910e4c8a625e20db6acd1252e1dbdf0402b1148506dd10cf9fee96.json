ULD_CALL_API","brandFaqList":[],"brandFaqListStatus":"SHOULD_CALL_API","home":{"seoContent":{},"downloadBannerContent":{},"newSolutions":[]},"reservation":{},"thankYou":{},"videoCall":{},"enableCitySearch":true,"hideHotline":false,"hideAppDownloadLinkThankYouPage":false,"hideInsurance":false,"shouldEnableAuthentication":false,"disabledContextsForBrand":[],"isVezeeta":true},"homeVisits":{"homeVisitsWebViewSpecialities":{"status":"SHOULD_CALL_API"}},"QnA":{"questionsAndAnswers":{"status":"SHOULD_CALL_API"},"recommendedDoctors":{"status":"SHOULD_CALL_API"},"scheduleData":{"status":"SHOULD_CALL_API"},"frequentlyAskedQuestions":{"data":[{"FrequentlyAskedQuestionsKey":"eb850354-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":"ايه هو تخصص الباطنة؟","AnswerContent":"تخصص الباطنة بيركز على تشخيص وعلاج الأمراض اللي بتأثر على الأعضاء والأنظمة الداخلية في الجسم، زي الجهاز الهضمي والقلب والكلى والجهاز التنفسي والغدد الصماء والجهاز العصبي المركزي. ويشمل كمان مراقبة وإدارة المرضى المصابين بأمراض مزمنة"},{"FrequentlyAskedQuestionsKey":"eb850420-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":"دكتور الباطنة  بيعالج أمراض ايه؟","AnswerContent":"جميع التهابات الكبد الوبائى \u003cul\u003e \u003cli\u003eالفشل الكلوى\u003c/li\u003e \u003cli\u003eالقرحة الهضمية\u003c/li\u003e \u003cli\u003eتضخم الطحال\u003c/li\u003e \u003cli\u003eمرض السكر\u003c/li\u003e \u003cli\u003eأمراض الضغط\u003c/li\u003e \u003cli\u003eأمراض المريء والمعدة والاثنى عشر وغيرها من الأمراض المختلفة.\u003c/li\u003e \u003c/ul\u003e"},{"FrequentlyAskedQuestionsKey":"eb8504f1-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":"ايه هو تحليل السكر التراكمي؟","AnswerContent":"فحص السكري التراكمي هو تحليل نسبة السكر المرتبط بالهيموجلوبين في الدم، لتقييم فعالية العلاج ومدى التزام المريض به. وينبغي إجراء هذا الاختبار بشكل دوري لمرضى السكري كل 2-3 أشهر. وفي حالة الحصول على نتيجة سكري تراكمي طبيعية، يمكن تقليل عدد الفحوصات إلى مرة كل 6 أشهر. "},{"FrequentlyAskedQuestionsKey":"eb8505ce-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":"انهي ادق الجهاز الزئبقي ام الرقمي؟","AnswerContent":"الجهاز الرقمي هو الأكثر دقة بين الجهازين. فالجهاز الزئبقي يستخدم مستويات الزئبق لقياس الضغط، ويمكن أن تؤثر الظروف الخارجية مثل درجة الحرارة والرطوبة على دقة القراءة. بالمقارنة، يستخدم الجهاز الرقمي تقنيات الكترونية لقياس الضغط وليس لديه تأثير كبير من الظروف الخارجية."},{"FrequentlyAskedQuestionsKey":"eb850699-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":"ايه هي أعراض جرثومة المعدة؟","AnswerContent":"أعراض جرثومة المعدة تشمل :  \u003cul\u003e \u003cli\u003eالألم في البطن\u003c/li\u003e \u003cli\u003eالغثيان والقيء\u003c/li\u003e \u003cli\u003eالانتفاخ\u003c/li\u003e \u003cli\u003eفقدان الشهية\u003c/li\u003e \u003cli\u003eالحرقة والتجشؤ\u003c/li\u003e \u003cli\u003eالإسهال أو الإمساك\u003c/li\u003e \u003cli\u003eفقدان الوزن\u003c/li\u003e \u003cli\u003eالإحساس بالتعب والضعف العام\u003c/li\u003e \u003c/ul\u003e"},{"FrequentlyAskedQuestionsKey":"ebb7c700-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":"ايه أعراض القولون العصبي؟","AnswerContent":"أعراض القولون العصبي تشمل: \u003cul\u003e \u003cli\u003eآلام البطن والتشنجات والانتفاخات الغازية.\u003c/li\u003e \u003cli\u003eالإسهال أو الإمساك أو التبادل بينهم.\u003c/li\u003e \u003cli\u003eالشعور بالانتفاخ والامتلاء في البطن.\u003c/li\u003e \u003cli\u003eالإحساس بالتعب وعدم الراحة العامة.\u003c/li\u003e \u003cli\u003eالشعور بالقلق أو الاكتئاب.\u003c/li\u003e \u003c/ul\u003e"},{"FrequentlyAskedQuestionsKey":"ebb7d27a-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":"ايه اعراض الضغط العالي؟","AnswerContent":"الأعراض : \u003cul\u003e \u003cli\u003eالصداع\u003c/li\u003e \u003cli\u003eالدوخة والشعور بالتعب\u003c/li\u003e \u003cli\u003eالضيق في التنفس\u003c/li\u003e \u003cli\u003eالدم في البول\u003c/li\u003e \u003cli\u003eألم الصدر والتنميل في اليدين والقدمين\u003c/li\u003e \u003cli\u003eالتغيرات في الرؤية\u003c/li\u003e \u003c/ul\u003e خطورة ارتفاع الضغط الشديد بتزيد لو متعالجش بشكل صحيح، وممكن يؤدي لمضاعفات خطيرة."},{"FrequentlyAskedQuestionsKey":"ebb7d670-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":" ايه اعراض الضغط المنخفض؟","AnswerContent":" أعراض الضغط المنخفض تشمل: \u003cul\u003e   \u003cli\u003eالدوار والدوخة\u003c/li\u003e   \u003cli\u003eالإحساس بالتعب والخمول\u003c/li\u003e   \u003cli\u003eصداع خفيف\u003c/li\u003e   \u003cli\u003eعدم وضوح الرؤية\u003c/li\u003e   \u003cli\u003eضعف الذاكرة والتركيز\u003c/li\u003e   \u003cli\u003eالشعور بالغثيان\u003c/li\u003e   \u003cli\u003eالشعور بالإجهاد وضيق التنفس\u003c/li\u003e   \u003cli\u003eتسارع ضربات القلب\u003c/li\u003e   \u003cli\u003eالإحساس بالبرودة في اليدين والقدمين\u003c/li\u003e \u003c/ul\u003e"},{"FrequentlyAskedQuestionsKey":"ebb7d856-e74c-11ed-8fda-0a5f3ffe4c9b","GenericSpecialityKey":"spec00000020","LanguageId":2,"QuestionContent":" ايه أعراض القرحة الهضمية؟","AnswerContent":" أعراض القرحة الهضمية تشمل: \u003cul\u003e         \u003cli\u003eألم حاد في المنطقة العلوية من البطن\u003c/li\u003e         \u003cli\u003eشعور بالشبع والانتفاخ والغثيان والتجشؤ.\u003c/li\u003e         \u003cli\u003eفقدان الشهية والتقيؤ.\u003c/li\u003e         \u003cli\u003eتغييرات في الوزن.\u003c/li\u003e         \u003cli\u003eالبراز الداكن، أو الإسهال، أو الإمساك.\u003c/li\u003e     \u003c/ul\u003e"}]}},"diseases":{"currentSpecialty":{},"diseases":{"data":[],"totalCount":0},"disease":{},"relatedDiseases":[],"recommendedDoctors":{"status":"SHOULD_CALL_API","data":[]},"specialtiesWithDiseases":[]},"articles":{"currentCategory":{},"articles":{"data":[],"totalCount":0},"article":{},"relatedArticles":[],"recommendedDoctors":{"status":"SHOULD_CALL_API","data":[]},"categoriesWithArticles":[],"spe